{
  "name": "sleeper-gm",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal Sleeper fantasy-football GM tool (keepers, value, trades, inflation) for league 'Los Socios'.",
  "workspaces": [
    "core",
    "cli",
    "server",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures": "tsx scripts/refresh-fixtures.ts",
    "sgm": "tsx cli/src/index.ts",
    "sgm:trace": "tsx scripts/trace.ts",
    "server": "tsx server/src/index.ts",
    "web:dev": "npm -w @sgm/web run dev",
    "web:build": "npm -w @sgm/web run build",
    "web": "npm run web:build && npm run server",
    "values:adp": "tsx scripts/fetch-adp-values.ts",
    "values:espn": "tsx scripts/fetch-espn-values.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "web:static": "npm run snapshot && npm run web:build",
    "web:preview": "npm -w @sgm/web run preview"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
