# The user's GLOBAL gitignore (~/.gitignore_global) ignores `.github/`, which hid the deploy workflow
# from every repo. Re-include it here (repo rules override global) so refresh.yml is committable.
!.github/
!.github/**

node_modules/
.cache/
scripts/snapshots/
dist/
web/dist/
web/public/data.json
*.log
.env
config/salaries.json
.DS_Store
.claude/settings.local.json
